#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

// Structure to represent a weighted edge
struct Edge {
    int u, v, weight;
    
    // Sort edges in ascending order of weight
    bool operator<(const Edge& other) const {
        return weight < other.weight;
    }
};

// Disjoint Set Union (Union-Find) data structure
struct DSU {
    vector<int> parent, rank;
    
    DSU(int n) {
        parent.resize(n);
        rank.resize(n, 0);
        for (int i = 0; i < n; i++) {
            parent[i] = i;
        }
    }
    
    // Find with path compression
    int find(int i) {
        if (parent[i] == i)
            return i;
        return parent[i] = find(parent[i]);
    }
    
    // Union by rank; returns true if a merge occurred
    bool unite(int i, int j) {
        int root_i = find(i);
        int root_j = find(j);
        
        if (root_i != root_j) {
            if (rank[root_i] < rank[root_j]) {
                parent[root_i] = root_j;
            } else if (rank[root_i] > rank[root_j]) {
                parent[root_j] = root_i;
            } else {
                parent[root_j] = root_i;
                rank[root_i]++;
            }
            return true;
        }
        return false; // Already in the same set (would form a cycle)
    }
};

void kruskalMST(int V, vector<Edge>& edges) {
    // 1. Sort all edges by weight in non-decreasing order
    sort(edges.begin(), edges.end());
    
    DSU dsu(V);
    vector<Edge> mst;
    int totalWeight = 0;
    
    // 2. Iterate through sorted edges and pick those that don't form a cycle
    for (const auto& edge : edges) {
        if (dsu.unite(edge.u, edge.v)) {
            mst.push_back(edge);
            totalWeight += edge.weight;
            
            // Optimization: stop early once V - 1 edges are added
            if (mst.size() == V - 1) break;
        }
    }
    
    // Output the result
    cout << "Edges in the Minimum Spanning Tree:\n";
    for (const auto& edge : mst) {
        cout << edge.u << " -- " << edge.v << " == " << edge.weight << "\n";
    }
    cout << "Total MST Weight: " << totalWeight << "\n";
}

int main() {
    int V = 4; // Number of vertices (0 to 3)
    vector<Edge> edges = {
        {0, 1, 10},
        {0, 2, 6},
        {0, 3, 5},
        {1, 3, 15},
        {2, 3, 4}
    };
    
    kruskalMST(V, edges);
    
    return 0;
}
